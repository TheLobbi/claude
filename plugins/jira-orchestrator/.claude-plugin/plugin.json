    "agents",
    "clean-architecture",
    "solid",
    "mcp",
    "knowledge-graph",
    "sequential-thinking",
    "neon",
    "postgresql",
    "redis",
    "temporal",
    "agentic-design-patterns",
    "routing",
    "planning",
    "multi-agent",
    "memory-management",
    "reflection",
    "parallelization",
    "exception-handling",
    "human-in-the-loop",
    "evaluation-monitoring",
    "prioritization",
    "goal-setting"
  ],
  "license": "MIT",
  "repository": "https://github.com/Lobbi-Docs/claude",
  "contextEntry": "CONTEXT_SUMMARY.md",
