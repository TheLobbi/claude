{
  "name": "frontend-design-system",
  "version": "2.1.0",
  "description": "Design styles with multi-tenant Keycloak theming and Chakra UI v3 output for AI-powered frontend development; ships a design-styles MCP server",
  "author": {
    "name": "Markus Ahling"
  },
  "license": "MIT",
  "repository": "https://github.com/markus41/claude/tree/main/plugins/frontend-design-system",
  "keywords": [
    "frontend",
    "design-system",
    "keycloak",
    "theming",
    "css",
    "tailwind",
    "ui-ux",
    "multi-tenant",
    "accessibility",
    "agentic-patterns",
    "prompt-chaining",
    "routing",
    "reflection",
    "planning",
    "tool-use",
    "memory",
    "parallelization",
    "guardrails",
    "chakra-ui",
    "chakra-ui-v3",
    "design-tokens",
    "mcp"
  ],
  "contextEntry": "CONTEXT_SUMMARY.md",
  "context": {
    "entry": "CONTEXT_SUMMARY.md",
    "title": "Frontend Design System",
    "summary": "Design styles with multi-tenant Keycloak theming and Chakra UI v3 output. 8 commands, 6 agents, 6 skills, 2 MCP servers (design-styles, chakra-ui).",
    "tags": [
      "frontend",
      "design-system",
      "keycloak",
      "theming",
      "css",
      "tailwind",
      "ui-ux",
      "accessibility",
      "chakra-ui",
      "design-tokens",
      "mcp"
    ],
    "bootstrapFiles": [
      "CONTEXT_SUMMARY.md"
    ],
    "maxTokens": 700,
    "excludeGlobs": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/*.zip",
      "**/coverage/**",
      "**/*.tar*"
    ],
    "lazyLoadSections": [
      "CLAUDE.md",
      "skills/*/SKILL.md",
      "commands/*.md"
    ]
  },
  "permissions": {
    "requires": [
      "read"
    ],
    "optional": [
      "write",
      "bash",
      "glob",
      "grep",
      "agent",
      "mcp",
      "network"
    ]
  },
  "capabilities": {
    "provides": [
      "frontend",
      "design-system",
      "keycloak",
      "theming",
      "css",
      "tailwind",
      "ui-ux",
      "multi-tenant",
      "chakra-ui",
      "design-tokens",
      "mcp"
    ],
    "requires": []
  },
  "mcpServers": {
    "design-styles": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp-server/src/index.js"
      ]
    },
    "chakra-ui": {
      "command": "npx",
      "args": [
        "-y",
        "@chakra-ui/react-mcp@2.1.1"
      ]
    }
  }
}
